{
  "name": "cardinal",
  "private": true,
  "version": "0.1.0",
  "description": "Cardinal: a backstage-only AI Co-DM assistant for tabletop RPG Dungeon Masters (D&D 5e 2024).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @cardinal/app dev",
    "preview": "pnpm --filter @cardinal/app preview",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
